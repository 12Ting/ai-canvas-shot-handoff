{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.e2e.json --noEmit && vite build",
    "e2e": "playwright test",
    "e2e:noauth": "playwright test --config playwright.noauth.config.ts",
    "e2e:release": "npm run build && playwright test --config playwright.release.config.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run --exclude e2e/**",
    "api:types": "openapi-typescript src/api/openapi.json -o src/api/generated-schema.ts"
  },
  "dependencies": {
    "@xyflow/react": "12.11.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "oxlint": "^1.71.0",
    "typescript": "5.9.3",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
